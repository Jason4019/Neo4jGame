(n10:Person{name:"赤精子", desc:"阐教十二金仙，殷洪师父"}),
(n11:Person{name:"姜子牙", desc:"阐教弟子，封神榜执掌人，元始天尊门下"}),
(n12:Person{name:"元始天尊", desc:"阐教教主，三清之一，姜子牙、十二金仙的老师"}),
(n13:Person{name:"申公豹", desc:"阐教叛徒，姜子牙师弟，到处游说截教仙人出战"}),
(n14:Person{name:"敖广", desc:"东海龙王，龙族首领，哪吒闹海的主要对手"}),
(n15:Person{name:"敖丙", desc:"东海龙王三太子，被哪吒打死，灵珠转世"}),
(n16:Person{name:"石矶娘娘", desc:"骷髅山白骨洞，截教仙人，与哪吒结怨"}),
(n17:Person{name:"杨戬", desc:"玉鼎真人弟子，清源妙道真君，三只眼，八九玄功"}),
(n18:Person{name:"玉鼎真人", desc:"阐教十二金仙，杨戬师父"}),
(n19:Person{name:"黄飞虎", desc:"武成王，商朝大将，后归周"}),
(n20:Person{name:"哮天犬", desc:"杨戬的伙伴神兽"}),
