MATCH (n) DETACH DELETE n;
CREATE 
(n1:Person{name:"李靖", desc:"陈塘关总兵，哪吒之父，金吒木吒哪吒父亲"}),
(n2:Person{name:"殷夫人", desc:"李靖妻子，哪吒生母"}),
(n3:Person{name:"金吒", desc:"李靖长子，文殊广法天尊弟子"}),
(n4:Person{name:"木吒", desc:"李靖次子，普贤真人弟子"}),
(n5:Person{name:"哪吒", desc:"莲花化身，太乙真人弟子，三坛海会大神"}),
(n6:Person{name:"太乙真人", desc:"阐教十二金仙，哪吒授业恩师，乾元山金光洞主人"}),
(n7:Person{name:"文殊广法天尊", desc:"阐教十二金仙，金吒师父"}),
(n8:Person{name:"普贤真人", desc:"阐教十二金仙，木吒师父"}),
